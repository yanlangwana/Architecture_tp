# Données brutes Kaggle mono ou multi-datasets (volumineuses, hors dépôt Git)
data_raw/*
!data_raw/.gitkeep

# Artefacts Python / Jupyter / Spark locaux
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
spark-warehouse/
metastore_db/
derby.log
.venv/

# Artefacts MLOps locaux (mode de repli MLflow sans serveur, rapports d'exécution)
mlops/mlflow.db
mlops/mlartifacts/
mlops/runs/

# macOS
.DS_Store
